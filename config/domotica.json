{
  "scenario": {
    "id": "domotica",
    "name": "Casa Inteligente",
    "description": "Monitorização e gestão de uma habitação inteligente"
  },
  "dashboard": {
    "charts": {
      "temperatura": true,
      "humidade": true,
      "luminosidade": true,
      "movimento": false,
      "consumo_agua": true
    }
  },
  "zones": [
    {
      "id": "sala",
      "name": "Sala",
      "sensors": [
        {
          "id": "sensor_001",
          "name": "Sensor Ambiental da Sala",
          "type": "ambiental",
          "metrics": [
            {
              "field": "temperatura",
              "label": "Temperatura",
              "unit": "°C",
              "alerts": {
                "min": 10.0,
                "max": 30.0
              }
            },
            {
              "field": "humidade",
              "label": "Humidade",
              "unit": "%",
              "alerts": {
                "min": 35.0,
                "max": 75.0
              }
            }
          ]
        },
        {
          "id": "sensor_002",
          "name": "Sensor de Luminosidade da Sala",
          "type": "luminosidade",
          "metrics": [
            {
              "field": "luminosidade",
              "label": "Luminosidade",
              "unit": "lux",
              "alerts": {
                "min": 100.0,
                "max": 800.0
              }
            }
          ]
        },
        {
          "id": "sensor_004",
          "name": "Sensor Consumo de Água",
          "type": "personalizado",
          "metrics": [
            {
              "field": "consumo_agua",
              "label": "Consumo de Água",
              "unit": "L",
              "data_type": "number",
              "measurement_type": "acumulado",
              "alerts": {
                "min": 0.0,
                "max": 500.0
              }
            }
          ]
        }
      ]
    },
    {
      "id": "entrada",
      "name": "Entrada",
      "sensors": [
        {
          "id": "sensor_003",
          "name": "Sensor de Movimento da Entrada",
          "type": "movimento",
          "metrics": [
            {
              "field": "movimento",
              "label": "Movimento",
              "unit": "",
              "data_type": "boolean",
              "alerts": {
                "high_activity": 7,
                "persistent_activity": 9,
                "min": 0,
                "max": 1
              }
            }
          ]
        }
      ]
    }
  ]
}
