{
  "scenario": {
    "id": "agricultura",
    "name": "Agricultura Inteligente",
    "description": "Monitorização inteligente de um ambiente agrícola"
  },
  "dashboard": {
    "charts": {
      "temperatura": true,
      "humidade": true,
      "luminosidade": true,
      "movimento": false,
      "humidade_solo": true
    }
  },
  "zones": [
    {
      "id": "estufa",
      "name": "Estufa",
      "sensors": [
        {
          "id": "sensor_001",
          "name": "Sensor Ambiental da Estufa",
          "type": "ambiental",
          "metrics": [
            {
              "field": "temperatura",
              "label": "Temperatura",
              "unit": "°C",
              "alerts": {
                "min": 10.0,
                "max": 30.0
              }
            },
            {
              "field": "humidade",
              "label": "Humidade",
              "unit": "%",
              "alerts": {
                "min": 35.0,
                "max": 75.0
              }
            }
          ]
        },
        {
          "id": "sensor_002",
          "name": "Sensor de Luminosidade da Estufa",
          "type": "luminosidade",
          "metrics": [
            {
              "field": "luminosidade",
              "label": "Luminosidade",
              "unit": "lux",
              "alerts": {
                "min": 100.0,
                "max": 800.0
              }
            }
          ]
        },
        {
          "id": "sensor_004",
          "name": "Sensor Humidade do Solo",
          "type": "personalizado",
          "metrics": [
            {
              "field": "humidade_solo",
              "label": "Humidade do Solo",
              "unit": "%",
              "data_type": "number",
              "measurement_type": "instantaneo",
              "alerts": {
                "min": 20.0,
                "max": 80.0
              },
              "chart_type": "barra"
            }
          ]
        },
        {
          "id": "sensor_rest_001",
          "name": "Fonte REST Exemplo",
          "type": "rest",
          "metrics": [
            {
              "field": "temperatura_externa",
              "label": "Temperatura Externa",
              "unit": "°C",
              "data_type": "number",
              "measurement_type": "instantaneo",
              "chart_type": "linha",
              "alerts": {
                "min": 0.0,
                "max": 40.0
              }
            }
          ]
        }
      ]
    },
    {
      "id": "zona_acesso",
      "name": "Zona de Acesso",
      "sensors": [
        {
          "id": "sensor_003",
          "name": "Sensor de Movimento",
          "type": "movimento",
          "metrics": [
            {
              "field": "movimento",
              "label": "Movimento",
              "unit": "",
              "data_type": "boolean",
              "alerts": {
                "high_activity": 7,
                "persistent_activity": 9,
                "min": 0,
                "max": 1
              }
            }
          ]
        }
      ]
    }
  ],
  "data_sources": [
    {
      "id": "rest_exemplo",
      "enabled": true,
      "name": "Fonte REST Exemplo",
      "type": "rest",
      "method": "GET",
      "url": "https://api.open-meteo.com/v1/forecast?latitude=38.57&longitude=-7.91&current=temperature_2m",
      "interval_seconds": 300,
      "sensor_id": "sensor_rest_001",
      "metric": "temperatura_externa",
      "json_path": "current.temperature_2m",
      "unit": "°C",
      "min": 0.0,
      "max": 40.0
    }
  ]
}
